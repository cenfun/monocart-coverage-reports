{
    "name": "monocart-coverage-reports",
    "version": "3.2.0",
    "description": "A code coverage tool to generate native V8 reports or Istanbul reports.",
    "type": "module",
    "main": "./lib/index.js",
    "bin": {
        "mcr": "./lib/cli.js"
    },
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "default": "./lib/index.js"
        },
        "./register": "./lib/register/register.js",
        "./converter": "./lib/converter/converter.js",
        "./util": "./lib/utils/util.js",
        "./package.json": "./package.json",
        "./skills/*": "./skills/*"
    },
    "types": "./lib/index.d.ts",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "postbuild": "npm run build-test",
        "build-test": "node ./test/build/build-test.js",
        "test-unit": "node --test \"test/unit/*.test.js\"",
        "test-unit-coverage": "node ./lib/cli.js test -c test/mcr.config.unit.js",
        "test-types": "tsc -p test/types/tsconfig.json",
        "test-runtime": "node ./scripts/test-runtime.js",
        "test-node-env": "cross-env NODE_V8_COVERAGE=.temp/v8-coverage-env node ./test/test-node-env.js && node ./test/generate-report.js",
        "test-node-api": "cross-env NODE_V8_COVERAGE=.temp/v8-coverage-api node ./test/test-node-api.js",
        "test-node-ins": "node ./test/test-node-ins.js",
        "test-node-cdp": "node --inspect=9229 ./test/test-node-cdp.js",
        "test-node-vm": "node ./test/test-node-vm.js",
        "test-node-koa": "node ./test/test-node-koa.js",
        "test-node-fgc": "node ./test/test-node-fgc.js",
        "test-node": "node ./test/test.js --node",
        "test-istanbul": "node ./test/test-istanbul.js",
        "test-v8": "node ./test/test-v8.js",
        "test-puppeteer": "node ./test/test-puppeteer.js",
        "test-css": "node ./test/test-css.js",
        "test-css-min": "node ./test/test-css-min.js",
        "test-minify": "node ./test/test-minify.js",
        "test-esbuild": "node ./test/test-esbuild.js",
        "test-rollup": "node ./test/test-rollup.js",
        "test-sections": "node ./test/test-sections.js",
        "test-swc": "node ./test/test-swc.js",
        "test-v8-and-istanbul": "node ./test/test-v8-and-istanbul.js",
        "test-browser": "node ./test/test.js --browser",
        "test-cli": "node ./lib/cli.js node ./test/specs/node.test.js -c test/mcr.config.cli.js",
        "test-demo": "node ./test/test-demo.js",
        "test-merge": "node ./test/test-merge.js",
        "test-merge-istanbul": "node ./test/test-merge-istanbul.js",
        "test-merge-v8": "node ./test/test-merge-v8.js",
        "test-merge-cli": "node ./lib/cli.js merge -r console-details,v8 --inputDir .temp/code-coverage/raw --outputDir .temp/merge-cli",
        "test-client": "node ./test/test-client.js",
        "test-cp": "node ./lib/cli.js node test/test-cp.mjs --outputDir .temp/test-cp",
        "test-all": "node ./test/test.js",
        "test-pr": "node --inspect=9230 ./test/test-pr.js",
        "test": "npm run test-unit && npm run test-types && node ./lib/cli.js npm run test-all -c test/mcr.config.mcr.js && node ./scripts/docs.js",
        "test:snap": "cross-env TEST_SNAPSHOT=true npm run test",
        "open": "node ./scripts/open.js",
        "eol": "git rm -rf --cached . && git reset --hard HEAD",
        "lint": "eslint src/ test/unit/ --fix && stylelint src/**/*.scss && npm run lint:readme",
        "lint:readme": "node ./scripts/lint-readme.js",
        "version": "npm run build",
        "publish": "node ./scripts/publish.js"
    },
    "files": [
        "lib",
        "README.zh-Hans.md",
        "migrate-to-3.md",
        "skills"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/cenfun/monocart-coverage-reports.git"
    },
    "dependencies": {
        "@jridgewell/sourcemap-codec": "^1.6.0",
        "acorn": "^8.19.0",
        "acorn-loose": "^8.5.2",
        "acorn-walk": "^8.3.5",
        "commander": "^15.0.0",
        "console-grid": "^2.2.4",
        "convert-source-map": "^2.0.0",
        "eight-colors": "^1.3.3",
        "execa": "^10.2.1",
        "istanbul-lib-coverage": "^3.2.2",
        "istanbul-lib-report": "^3.0.1",
        "istanbul-reports": "^3.2.0",
        "lz-utils": "^2.1.1",
        "monocart-locator": "^1.0.6",
        "node-stream-zip": "^1.16.0",
        "ws": "^8.22.0",
        "yazl": "^3.3.1"
    },
    "devDependencies": {
        "@actions/core": "^3.0.1",
        "@actions/github": "^9.1.1",
        "@jsdevtools/coverage-istanbul-loader": "^3.0.5",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-typescript": "^12.3.1",
        "@swc/core": "^1.16.20",
        "@types/node": "^26.6.5",
        "@vitejs/plugin-vue": "^6.0.10",
        "async-tick": "^1.0.2",
        "axios": "^1.21.0",
        "babel-loader": "^10.1.1",
        "babel-plugin-istanbul": "^8.0.0",
        "cross-env": "^10.1.0",
        "diff-sequences": "^29.6.3",
        "eight-colors": "^1.3.3",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "eslint-config-plus": "^2.1.0",
        "eslint-plugin-html": "^8.2.1",
        "eslint-plugin-vue": "^10.12.0",
        "find-up": "^8.0.0",
        "koa": "^3.2.1",
        "koa-static-resolver": "^1.1.0",
        "minimatch": "^11.0.2",
        "monocart-code-viewer": "^1.2.0",
        "monocart-formatter": "^3.0.1",
        "open": "^11.0.4",
        "playwright": "^1.64.1",
        "postcss": "^8.5.32",
        "puppeteer": "^25.16.0",
        "rollup": "^4.65.1",
        "rollup-plugin-visualizer": "^7.1.1",
        "sass": "^1.106.1",
        "stylelint": "^17.16.0",
        "stylelint-config-plus": "^1.2.0",
        "supports-color": "^11.0.0",
        "swc-loader": "^0.2.7",
        "ts-loader": "^9.6.2",
        "tslib": "^2.8.1",
        "tsx": "^4.23.15",
        "turbogrid": "^3.4.2",
        "typescript": "^6.0.3",
        "vine-ui": "^4.2.0",
        "vite": "^8.3.5",
        "vite-plugin-css-injected-by-js": "^5.0.3",
        "webpack": "^5.112.2"
    },
    "engines": {
        "node": ">=22.15.0"
    },
    "puppeteer": {
        "skipDownload": true
    },
    "starfall": {
        "outdate": {
            "exclude": [
                "typescript"
            ]
        }
    }
}
